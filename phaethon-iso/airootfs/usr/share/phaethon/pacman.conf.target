#
# /etc/pacman.conf for an INSTALLED PhaethonOS system.
#
# shellprocess@before-online installs this into the target before pacstrap
# runs. It deliberately is NOT a copy of the ISO's build-time pacman.conf:
# that one may enable the [phaethon] repository from a file:// path which only
# exists on the build host, and an installed system pointing at a dead local
# repo fails every `pacman -Sy`.
#

[options]
HoldPkg     = pacman systemd
CleanMethod = KeepInstalled
Architecture = auto

Color
ILoveCandy
CheckSpace
VerbosePkgLists
ParallelDownloads = 8

SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

# ==============================================================================
# CACHYOS REPOSITORIES (HIGH-PERFORMANCE PACKAGES & KERNELS)
# ==============================================================================
# Provides linux-cachyos and the CachyOS-built userland this system runs on.
# Must stay ahead of [core]/[extra] so its optimised builds win.
#
# An explicit Server rather than `Include = /etc/pacman.d/cachyos-mirrorlist`:
# this file is installed into the target *before* pacstrap, so no package has
# provided a cachyos-mirrorlist yet and an Include of a missing file aborts
# pacman outright. Switch to the mirrorlist after install if you want mirror
# ranking; cachyos-mirrorlist is in the package manifest.
[cachyos]
Server = https://mirror.cachyos.org/repo/$arch/$repo

# ==============================================================================
# STANDARD ARCH REPOSITORIES
# ==============================================================================
[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

# ==============================================================================
# MULTILIB (REQUIRED FOR STEAM / WINE / 32-BIT GAMING)
# ==============================================================================
[multilib]
Include = /etc/pacman.d/mirrorlist
