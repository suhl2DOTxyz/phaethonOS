#
# /etc/pacman.conf for an INSTALLED PhaethonOS system.
#
# shellprocess@before-online installs this into the target before pacstrap
# runs. It deliberately is NOT a copy of the ISO's build-time pacman.conf:
# that one may enable the [phaethon] repository from a file:// path which only
# exists on the build host, and an installed system pointing at a dead local
# repo fails every `pacman -Sy`.
#

[options]
HoldPkg     = pacman systemd
CleanMethod = KeepInstalled
Architecture = auto

Color
ILoveCandy
CheckSpace
VerbosePkgLists
ParallelDownloads = 8

# Deliberately stricter than the live ISO, which uses `SigLevel = Optional
# TrustAll` for [cachyos]. That is a reasonable build-time convenience on a
# throwaway live session, but on somebody's actual machine it would disable
# signature verification for every CachyOS package forever. This relies on the
# keyring that shellprocess@initialize_pacman populates and
# shellprocess@before-online copies into the target.
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

# ==============================================================================
# CACHYOS REPOSITORIES (HIGH-PERFORMANCE PACKAGES & KERNELS)
# ==============================================================================
# Provides linux-cachyos and the CachyOS-built userland this system runs on.
# Must stay ahead of [core]/[extra] so its optimised builds win.
#
# This Include has to resolve before pacstrap has installed anything, so
# shellprocess@before-online copies the live ISO's cachyos-mirrorlist into the
# target first -- an Include of a missing file aborts pacman outright. The
# cachyos-mirrorlist package later lands on top of that copy.
[cachyos]
Include = /etc/pacman.d/cachyos-mirrorlist

# ==============================================================================
# STANDARD ARCH REPOSITORIES
# ==============================================================================
[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

# ==============================================================================
# MULTILIB (REQUIRED FOR STEAM / WINE / 32-BIT GAMING)
# ==============================================================================
[multilib]
Include = /etc/pacman.d/mirrorlist
