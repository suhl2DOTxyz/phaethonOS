#!/bin/bash
# ==============================================================================
# PHAETHON OS - CALAMARES RUNNER WRAPPER
# ==============================================================================
# Resolves library mismatches, grants display permissions, and launches
# Calamares in both live ISO and installed-system contexts.
#
set -o pipefail

CALAMARES_BIN="/usr/bin/calamares"
LOG_TAG="phaethon-calamares"

log() { echo "[$LOG_TAG] $*" >&2; }
warn() { echo "[$LOG_TAG] WARNING: $*" >&2; }
die() {
    echo "[$LOG_TAG] FATAL: $*" >&2
    if command -v notify-send &>/dev/null; then
        notify-send -a "Phaethon OS" -u critical "Installer Error" "$*" 2>/dev/null || true
    fi
    exit 1
}

# --- Find Calamares ---
if [ ! -x "$CALAMARES_BIN" ]; then
    CALAMARES_BIN=$(command -v calamares 2>/dev/null)
    if [ -z "$CALAMARES_BIN" ]; then
        die "Calamares binary not found. Is cachyos-calamares installed?"
    fi
fi
log "Using Calamares: $CALAMARES_BIN"

# --- Install the PhaethonOS Calamares module configuration ---
# phaethon-calamares-config.service already does this at boot; repeating it here
# is cheap, idempotent, and means the installer still gets PhaethonOS's configs
# rather than the CachyOS defaults if that unit never ran. See
# /usr/local/bin/phaethon-install-calamares-config for why these cannot simply
# ship at /etc/calamares/modules/ in the ISO overlay.
if [ -d /usr/share/phaethon/calamares/modules ]; then
    if [ "$(id -u)" -eq 0 ]; then
        /usr/local/bin/phaethon-install-calamares-config || warn "Could not install module configs"
    else
        sudo -n /usr/local/bin/phaethon-install-calamares-config || warn "Could not install module configs"
    fi
fi

# --- Fix library mismatches ---
# Delegated to phaethon-fix-libs.sh, which must run as root. This used to be an
# inline loop right here -- but everything above the sudo exec at the bottom of
# this script runs as the unprivileged live user, so its `ln -sf` into /usr/lib
# got EACCES, `2>/dev/null` swallowed the error and `&&` skipped the success
# log. The repair silently did nothing on every launch; the only visible symptom
# was Calamares still dying on a missing library.
#
# phaethon-fix-libs.service already runs this at boot. Repeating it here is
# idempotent and covers a session where that unit did not run.
if [ -x /usr/local/bin/phaethon-fix-libs.sh ]; then
    if [ "$(id -u)" -eq 0 ]; then
        /usr/local/bin/phaethon-fix-libs.sh || warn "library repair reported unresolved libraries"
    else
        sudo -n /usr/local/bin/phaethon-fix-libs.sh || warn "library repair reported unresolved libraries"
    fi
fi

# --- Refuse to launch into a dynamic-linker error ---
# Re-check after the repair attempts above. Launching anyway just dumps
# "error while loading shared libraries: ... cannot open shared object file"
# on the user with no indication of what to do about it.
# `ldd -r`, not plain `ldd`. Plain ldd only proves each soname resolves to a
# file, which a same-name-different-ABI symlink satisfies -- and Calamares
# then dies with "symbol lookup error" after this script has already said it
# was fine. -r binds the symbols too, which is the check that matters.
STILL_MISSING=$(ldd -r "$CALAMARES_BIN" 2>&1 | grep -E "not found|undefined symbol")
if [ -n "$STILL_MISSING" ]; then
    warn "Calamares still has unresolved libraries after repair:"
    printf '%s\n' "$STILL_MISSING" | while read -r lib; do
        warn "  $lib"
        # A boost-python soname encodes BOTH the Python ABI and the boost
        # release (libboost_python314.so.1.91.0 = Python 3.14, boost 1.91.0), so
        # a mismatch here means cachyos-calamares was built against a different
        # boost/python pair than the one the repos are currently shipping. That
        # cannot be repaired with a symlink: a boost-python built for another
        # Python links a libpython this system does not have.
        case "$lib" in
            libboost_python*)
                warn "  -> this is a boost/python version mismatch, not a broken install."
                warn "     present on this system:"
                found=$(find /usr/lib -maxdepth 1 -name 'libboost_python*' 2>/dev/null)
                if [ -n "$found" ]; then
                    echo "$found" | while read -r f; do warn "       $(basename "$f")"; done
                else
                    warn "       (none -- the boost-libs package provides no python component)"
                fi
                warn "     installed: $(pacman -Q boost-libs python 2>/dev/null | tr '\n' ' ')"
                warn "     cachyos-calamares needs the boost-libs build matching $lib."
                ;;
        esac
    done
    die "Calamares cannot start -- see the diagnosis above."
fi

# --- Preserve and launch ---
# Calamares partitions disks and pacstraps a system; it must be root, and it
# refuses to proceed otherwise ("The installer is not running with
# administrator rights").
#
# This condition used to be `if [ -n "$SUDO_USER" ]`, which is exactly
# backwards. SUDO_USER is set only when this script was ALREADY invoked through
# sudo -- so launching from the desktop icon or a plain shell left it unset, took
# the else branch, and started Calamares as the unprivileged live user. It
# elevated only in the one case where it was already elevated.
#
# The right question is simply "am I root".
if [ "$(id -u)" -eq 0 ]; then
    log "Already running as root"
    exec "$CALAMARES_BIN" "$@"
fi

log "Elevating via sudo (current user: $(id -un))"
# -E alone is not enough: sudoers resets the environment, so the display
# variables Calamares needs are passed explicitly. XAUTHORITY matters on X11 --
# without it a root Qt process cannot open the user's display.
exec sudo -E env \
    DISPLAY="${DISPLAY}" \
    XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    XDG_SESSION_TYPE="${XDG_SESSION_TYPE}" \
    QT_QPA_PLATFORM="${QT_QPA_PLATFORM}" \
    "$CALAMARES_BIN" "$@"
