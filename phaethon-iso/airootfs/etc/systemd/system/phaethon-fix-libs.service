[Unit]
Description=Phaethon OS - Resolve Calamares shared library skew
Documentation=file:///usr/local/bin/phaethon-fix-libs.sh

# The unit previously carried DefaultDependencies=no and Before=calamares.desktop.
# Neither was right: calamares.desktop is a desktop entry, not a unit, so the
# ordering was silently ignored; and DefaultDependencies=no drops the implicit
# ordering after local-fs.target, letting a service that reads /usr/lib and
# writes symlinks into it run before the filesystems are ready.
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/usr/local/bin/phaethon-fix-libs.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/phaethon-fix-libs.sh
# The script exits non-zero when libraries are still unresolved, which is worth
# seeing in `systemctl status` -- but it must not block the boot or hold up the
# display manager. phaethon-calamares re-runs it and reports properly.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
